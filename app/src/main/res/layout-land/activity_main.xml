<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/button_browser"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#B541FF"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="@string/button_label_browser" />

    <Button
        android:id="@+id/button_toast"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#B541FF"
        android:layout_below="@id/button_browser"
        android:layout_alignParentStart="true"
        android:text="@string/button_label_toast" />

    <Button
        android:id="@+id/button_count"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#B541FF"
        android:layout_below="@id/button_toast"
        android:layout_alignParentStart="true"
        android:text="@string/button_label_count" />

    <Button
        android:id="@+id/button_switchpage"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#B541FF"
        android:layout_below="@id/button_count"
        android:layout_alignParentStart="true"
        android:text="@string/button_label_pindah" />
    <TextView
        android:id="@+id/show_count"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/button_browser"
        android:layout_marginStart="16dp"
        android:background="#FFFF00"
        android:gravity="center"
        android:text="@string/count_initial_value"
        android:textColor="#333333"
        android:textSize="100sp" />

</RelativeLayout>